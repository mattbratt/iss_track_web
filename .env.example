# Rename this file to .env and keep it beside docker-compose.yml. It is a
# secret: never commit it or paste it anywhere.
#
# The token comes from the Cloudflare Zero Trust dashboard: Networks,
# Tunnels, your tunnel, Install connector. In the tunnel's Public Hostname
# use service type HTTP and URL iss_track_web:8000.
CLOUDFLARE_TUNNEL_TOKEN=paste-your-tunnel-token-here
